{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeMinor"
  ],
  "argocd": {
    "managerFilePatterns": [
      "argocd/.+\\.ya?ml$"
    ]
  },
  "kustomize": {
    "managerFilePatterns": [
      "apps/.+/kustomization\\.ya?ml$"
    ]
  },
  "dependencyDashboard": true,
  "assignees": ["giraffacarp"],
  "schedule": ["on saturday"],
  "minimumReleaseAge": "7 days"
}
